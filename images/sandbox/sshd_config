Include /etc/corral/sshd_env.conf

Port 22
HostKey /etc/ssh/corral_host_key
AuthorizedKeysFile /etc/ssh/corral_authorized_keys

AllowUsers sandbox
PermitRootLogin no
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
UsePAM yes

AllowTcpForwarding yes
X11Forwarding no
PrintMotd no

Subsystem sftp /usr/lib/openssh/sftp-server
