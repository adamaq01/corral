#!/bin/bash
set -euo pipefail

corral-home-init

if [[ "${CORRAL_SSHD:-}" != 1 ]]; then
  exec sleep infinity
fi

# The engine writes /etc/ssh/corral_authorized_keys and /etc/corral/sshd_env.conf before each start.
: "${CORRAL_SSH_HOST_KEY:?CORRAL_SSHD=1 needs CORRAL_SSH_HOST_KEY}"
printf '%s\n' "$CORRAL_SSH_HOST_KEY" | sudo install -o root -g root -m 0600 /dev/stdin /etc/ssh/corral_host_key

unset "${!CORRAL_@}"
sudo mkdir -p /run/sshd
exec sudo /usr/sbin/sshd -D -e
