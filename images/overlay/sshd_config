Include /etc/corral/sshd_env.conf

Port 22
HostKey /etc/ssh/corral_host_key
AuthorizedKeysFile /etc/ssh/corral_authorized_keys
PidFile /run/corral-sshd.pid

AllowUsers sandbox
PermitRootLogin no
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no

AllowTcpForwarding yes
X11Forwarding no
PrintMotd no

Subsystem sftp /opt/corral/libexec/sftp-server
