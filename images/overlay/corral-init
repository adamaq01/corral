#!/opt/corral/bin/sh
# Makes any base image a Corral sandbox. It runs only the overlay's static busybox, never the
# base image's tools, which may be missing or of any libc, except the image's own git, which the
# sandbox user's first start clones a repository with.
set -eu

O=/opt/corral
B=$O/bin/busybox
SANDBOX_ID=1000
HOME_DIR=/home/sandbox
STAGED=/etc/corral/home-files
# What corral-init wrote at the last start, a "<sha256> <path>" line per file, and what it has
# to tell the sandbox user about this start, which corral-shell and `corral status` show.
OWN_DIR=$HOME_DIR/.config/corral
WRITTEN=$OWN_DIR/home-files
NOTICES=$OWN_DIR/notices
SUDOERS_LINE='sandbox ALL=(ALL:ALL) NOPASSWD: ALL'
PROFILE_LINE='case ":$PATH:" in *:/opt/corral/bin:*) ;; *) PATH="$PATH:/opt/corral/bin:/opt/corral/fallback" ;; esac'

# Replaces the content of the file $1 with what the rest of the arguments print, keeping its
# owner and mode.
replace() {
  local file=$1
  shift
  "$@" >"$file.corral-new"
  $B cat "$file.corral-new" >"$file"
  $B rm -f "$file.corral-new"
}

# Writes the sandbox user into passwd, group and shadow under $1, in place of any user or group
# named sandbox or numbered 1000, so the sandbox user is in its own group alone, and adds root and
# nobody when they are missing. Each function keeps its variables local: sh has no other scope.
accounts() {
  local dir=$1 gone
  $B mkdir -p "$dir"
  [ -e "$dir/passwd" ] || $B install -m 0644 /dev/null "$dir/passwd"
  [ -e "$dir/group" ] || $B install -m 0644 /dev/null "$dir/group"
  [ -e "$dir/shadow" ] || $B install -m 0600 /dev/null "$dir/shadow"
  gone=$($B awk -F: -v id=$SANDBOX_ID '$1 == "sandbox" || $3 == id { print $1 }' "$dir/passwd")
  replace "$dir/passwd" passwd_of "$dir/passwd"
  replace "$dir/group" group_of "$dir/group" "$gone"
  replace "$dir/shadow" shadow_of "$dir/shadow" "$gone"
}

passwd_of() {
  $B awk -F: -v id=$SANDBOX_ID '$1 != "sandbox" && $3 != id' "$1"
  $B grep -q '^root:' "$1" || echo "root:x:0:0:root:/root:$O/bin/sh"
  $B grep -q '^nobody:' "$1" || echo "nobody:x:65534:65534:nobody:/nonexistent:$O/fallback/false"
  echo "sandbox:x:$SANDBOX_ID:$SANDBOX_ID:Corral sandbox:$HOME_DIR:$O/bin/corral-shell"
}

group_of() {
  $B awk -F: -v OFS=: -v id=$SANDBOX_ID -v gone="$2" '
    BEGIN { split(gone, names, "\n"); for (i in names) skip[names[i]] = 1; skip["sandbox"] = 1 }
    $1 == "sandbox" || $3 == id { next }
    NF < 4 { print; next }
    {
      count = split($4, members, ","); kept = ""
      for (i = 1; i <= count; i++) if (!(members[i] in skip)) kept = kept (kept == "" ? "" : ",") members[i]
      $4 = kept
      print
    }' "$1"
  $B grep -q '^root:' "$1" || echo "root:x:0:"
  echo "sandbox:x:$SANDBOX_ID:"
}

shadow_of() {
  $B awk -F: -v gone="$2" 'BEGIN { split(gone, names, "\n"); for (i in names) skip[names[i]] = 1 }
    !($1 in skip) && $1 != "sandbox"' "$1"
  echo "sandbox:*:20000:0:99999:7:::"
}

# What the sandbox user's sessions need from /etc: its sudo rule for the image's own sudo, and
# the overlay's commands at the end of PATH for login shells whose profile resets it.
system() {
  accounts /etc
  $B mkdir -p /etc/sudoers.d /etc/profile.d
  echo "$SUDOERS_LINE" >/etc/sudoers.d/corral-sandbox
  $B chmod 0440 /etc/sudoers.d/corral-sandbox
  echo "$PROFILE_LINE" >/etc/profile.d/corral.sh
}

# Runs as the sandbox user: the skeleton on the first start, then the home files the engine
# staged, each replacing what is at its path. A file written at an earlier start and no longer
# staged is removed, unless it was changed since. Every start then applies the setup's MCP
# servers and gateway addresses to the agents' own files, and the first start clones the
# sandbox's repository, if it names one, each adding how it went to the notices.
home() {
  local skel first=
  if [ ! -e "$HOME_DIR/.corral-initialized" ]; then
    skel=$O/etc/skel
    if [ -n "$($B ls -A /etc/skel 2>/dev/null)" ]; then
      skel=/etc/skel
    fi
    $B cp -R "$skel/." "$HOME_DIR/"
    : >"$HOME_DIR/.corral-initialized"
    first=yes
  fi
  # Without its own directory, such as when a file sits at ~/.config, Corral still writes the
  # home files, and keeps no record.
  if ! $B mkdir -p "$OWN_DIR" 2>/dev/null; then
    OWN_DIR=$($B mktemp -d)
    WRITTEN=$OWN_DIR/home-files
    NOTICES=$OWN_DIR/notices
  fi
  [ -f "$WRITTEN" ] || : >"$WRITTEN"
  : >"$WRITTEN.new"
  : >"$NOTICES.new"
  [ ! -f "$STAGED/manifest" ] || write_staged <"$STAGED/manifest"
  remove_unstaged <"$WRITTEN"
  $B mv "$WRITTEN.new" "$WRITTEN"
  if [ -s "$NOTICES.new" ]; then
    $B mv "$NOTICES.new" "$NOTICES"
  else
    $B rm -f "$NOTICES.new" "$NOTICES"
  fi
  HOME=$HOME_DIR $O/bin/corral agents-apply
  [ -z "$first" ] || HOME=$HOME_DIR $O/bin/corral first-start
}

# Writes each file of the manifest on stdin. One that cannot be written, such as one with a
# directory at its path, must not keep the sandbox from starting: it is reported instead.
write_staged() {
  local line key rest mode path sum before error
  while IFS= read -r line; do
    key=${line%% *}
    rest=${line#* }
    mode=${rest%% *}
    path=${rest#* }
    sum=$(digest "$STAGED/$key")
    before=$(recorded "$path")
    if [ -d "$HOME_DIR/$path" ]; then
      error="a directory is in the way"
    elif error=$($B install -D -m "$mode" "$STAGED/$key" "$HOME_DIR/$path" 2>&1); then
      error=
    fi
    if [ -n "$error" ]; then
      notice "Corral could not write ~/$path: $error."
      [ -z "$before" ] || echo "$before $path" >>"$WRITTEN.new"
      continue
    fi
    echo "$sum $path" >>"$WRITTEN.new"
  done
}

# Removes each file of the record on stdin that is no longer staged and still holds what Corral
# wrote.
remove_unstaged() {
  local line sum path
  while IFS= read -r line; do
    sum=${line%% *}
    path=${line#* }
    [ -n "$(P=$path recorded_in "$WRITTEN.new")" ] && continue
    if [ -L "$HOME_DIR/$path" ] || [ ! -f "$HOME_DIR/$path" ]; then
      continue
    fi
    if [ "$(digest "$HOME_DIR/$path")" = "$sum" ]; then
      $B rm -f "$HOME_DIR/$path" 2>/dev/null || notice "Corral could not remove ~/$path."
    else
      notice "~/$path is no longer attached, but it was changed in the sandbox, so Corral left it."
    fi
  done
}

digest() {
  local sum
  sum=$($B sha256sum "$1")
  echo "${sum%% *}"
}

# The digest the last start recorded for the path $1, if any.
recorded() {
  P=$1 recorded_in "$WRITTEN"
}

recorded_in() {
  $B awk '{ path = substr($0, index($0, " ") + 1) } path == ENVIRON["P"] { print $1; exit }' "$1"
}

notice() {
  echo "$1" >>"$NOTICES.new"
}

as_sandbox() {
  $B su -s $O/bin/sh sandbox -c "$O/bin/corral-init home"
}

case "${1:-}" in
  docker)
    # Docker, as root: the accounts and the home, then the mark that sessions, each an exec of
    # corral-sshd, may start.
    system
    $B mkdir -p $HOME_DIR /run/corral
    if [ "$($B stat -c %u $HOME_DIR)" != $SANDBOX_ID ]; then
      $B chown $SANDBOX_ID:$SANDBOX_ID $HOME_DIR
      $B chmod 0750 $HOME_DIR
    fi
    as_sandbox
    : >/run/corral/ready
    # What the sandbox uses, reported to Corral, which decides from it when the sandbox is idle.
    $B su -s $O/bin/sh sandbox -c "exec $O/bin/corral report-activity" &
    exec $B sleep 2147483647
    ;;
  prepare)
    # Kubernetes init container, as root: the account files the sandbox container mounts from
    # the directory $2, and the home.
    dir=${2:?corral-init prepare needs a directory}
    accounts /etc
    $B install -m 0644 /etc/passwd "$dir/passwd"
    $B install -m 0644 /etc/group "$dir/group"
    $B install -m 0600 /etc/shadow "$dir/shadow"
    (umask 0337 && echo "$SUDOERS_LINE" >"$dir/sudoers")
    echo "$PROFILE_LINE" >"$dir/profile.sh"
    as_sandbox
    ;;
  idle)
    # Kubernetes sandbox container, as the sandbox user: sessions are execs into it.
    HOME=$HOME_DIR $O/bin/corral report-activity &
    exec $B sleep 2147483647
    ;;
  build)
    # An image build that bakes the overlay in, as root.
    system
    $B install -d -o $SANDBOX_ID -g $SANDBOX_ID -m 0750 $HOME_DIR
    ;;
  home)
    home
    ;;
  *)
    echo "usage: corral-init docker | prepare DIR | idle | build" >&2
    exit 2
    ;;
esac
